# Resend (contact form) — already in use
RESEND_API_KEY=

# ── ImageKit (catalog photos) ───────────────────────────────────────────────
# Create a free account at https://imagekit.io
# Dashboard → Developer options → API keys
#
# Do NOT paste real keys here. Copy to .env and fill locally.
# Also add the same keys in Vercel → Project → Settings → Environment Variables.

IMAGEKIT_PUBLIC_KEY=public_xxxxxxxx
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# Optional folder prefix inside ImageKit (default: sacartx)
# IMAGEKIT_FOLDER=sacartx

# Enable /img/ proxy URLs after upload + vercel.json rewrite are live
PUBLIC_IMAGEKIT_ENABLED=true
