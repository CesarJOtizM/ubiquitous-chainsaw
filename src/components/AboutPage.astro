---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from './Navbar.astro';
import Footer from './Footer.astro';
import WhatsAppFAB from './WhatsAppFAB.astro';
import { aboutCopy } from '../data/about';
import { business, founderId } from '../data/business';
import { leadTimeText, whereText } from '../lib/price-text';
import {
  aboutPath,
  blogPath,
  catalogPath,
  homePath,
  intentPath,
  pricesPath,
  productKeys,
  productPath,
  type Lang,
} from '../i18n/paths';
import { productEntry } from '../data/product-pages';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = aboutCopy[lang];
const SITE = business.site;
const canonicalUrl = `${SITE}${aboutPath(lang)}`;
const alternateEs = `${SITE}${aboutPath('es')}`;
const alternateEn = `${SITE}${aboutPath('en')}`;
const homeUrl = `${SITE}${homePath(lang)}`;
const waUrl = `https://wa.me/${business.phone.replace(/\D/g, '')}`;

const related = [
  { href: intentPath('how', lang), label: lang === 'en' ? 'How it works' : 'Cómo funciona' },
  { href: pricesPath(lang), label: lang === 'en' ? 'Prices' : 'Precios' },
  { href: catalogPath(lang), label: lang === 'en' ? 'Catalog' : 'Catálogo' },
  { href: blogPath(lang), label: 'Blog' },
  ...productKeys.map((key) => ({
    href: productPath(key, lang),
    label: productEntry(key, lang).linkLabel,
  })),
];

const contacts = [
  { href: waUrl, label: `WhatsApp ${business.phoneDisplay}`, external: true },
  { href: business.instagram, label: `Instagram ${business.handle}`, external: true },
  { href: business.tiktok, label: `TikTok ${business.handle}`, external: true },
  { href: business.facebook, label: 'Facebook Sac_Artx', external: true },
];

const person = {
  '@type': 'Person',
  '@id': founderId,
  name: business.founder,
  jobTitle: lang === 'en' ? 'Artist' : 'Artista',
  url: canonicalUrl,
  description: copy.lead,
  nationality: { '@type': 'Country', name: 'Colombia' },
  worksFor: { '@id': `${SITE}/#business` },
  sameAs: [business.instagram, business.tiktok, business.facebook],
  knowsAbout: [
    'Pet portraits',
    'Acrylic painting',
    'Custom phone cases',
    'Landscape painting',
  ],
};

const extraJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfilePage',
    '@id': `${canonicalUrl}#profile`,
    url: canonicalUrl,
    name: copy.h1,
    description: copy.metaDescription,
    inLanguage: lang === 'en' ? 'en' : 'es-CO',
    isPartOf: { '@id': `${SITE}/#website` },
    mainEntity: person,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: copy.crumbHome, item: homeUrl },
      { '@type': 'ListItem', position: 2, name: copy.crumbCurrent, item: canonicalUrl },
    ],
  },
];
---

<BaseLayout
  lang={lang}
  title={copy.metaTitle}
  description={copy.metaDescription}
  ogUrl={canonicalUrl}
  canonicalUrl={canonicalUrl}
  alternateEs={alternateEs}
  alternateEn={alternateEn}
  markdownAlt={false}
  extraJsonLd={extraJsonLd}
>
  <Navbar lang={lang} />
  <main>
    <div class="about-page">
      <header class="about-hero">
        <div class="container">
          <nav class="about-crumb" aria-label={lang === 'en' ? 'Breadcrumb' : 'Miga de pan'}>
            <a href={homePath(lang)}>{copy.crumbHome}</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">{copy.crumbCurrent}</span>
          </nav>
          <h1 class="about-hero__title">{copy.h1}</h1>
          <p class="about-hero__intro">{copy.lead}</p>
        </div>
      </header>

      <div class="container about-body">
        <section class="about-section">
          <h2>{copy.whoHeading}</h2>
          <p>{copy.whoBody}</p>
        </section>

        <section class="about-section">
          <h2>{copy.paintsHeading}</h2>
          <p>{copy.paintsIntro}</p>
          <ul>
            {copy.paints.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>

        <section class="about-section">
          <h2>{copy.orderHeading}</h2>
          <p>{copy.orderIntro}</p>
          <ol>
            {copy.orderSteps.map((step) => (
              <li>{step}</li>
            ))}
          </ol>
          <p>{leadTimeText(lang)}</p>
        </section>

        <section class="about-section">
          <h2>{copy.shipsHeading}</h2>
          <p>{whereText(lang, 'studio')}</p>
        </section>

        <section class="about-section">
          <h2>{copy.contactHeading}</h2>
          <p>{copy.contactIntro}</p>
          <ul class="about-contact">
            {contacts.map((item) => (
              <li>
                <a
                  href={item.href}
                  target={item.external ? '_blank' : undefined}
                  rel={item.external ? 'noopener noreferrer' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </section>

        <nav class="about-related" aria-label={copy.relatedHeading}>
          <h2>{copy.relatedHeading}</h2>
          <ul>
            {related.map((link) => (
              <li>
                <a href={link.href} data-astro-prefetch="viewport">{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </div>
  </main>
  <Footer lang={lang} />
  <WhatsAppFAB lang={lang} />
</BaseLayout>

<style>
  .about-page {
    padding-bottom: clamp(64px, 8vw, 120px);
  }

  .about-hero {
    padding: clamp(100px, 14vw, 140px) 0 clamp(32px, 4vw, 48px);
  }

  .about-crumb {
    display: flex;
    gap: 8px;
    align-items: center;
    flex-wrap: wrap;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-bottom: 20px;
  }

  .about-crumb a,
  .about-contact a,
  .about-related a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .about-crumb a:hover,
  .about-contact a:hover,
  .about-related a:hover {
    text-decoration: underline;
  }

  .about-hero__title {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 400;
    margin: 8px 0 12px;
  }

  .about-hero__intro,
  .about-section,
  .about-related {
    max-width: 720px;
  }

  .about-hero__intro {
    font-size: 1.0625rem;
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  .about-body {
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 4vw, 40px);
  }

  .about-section h2,
  .about-related h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 500;
    margin-bottom: 12px;
  }

  .about-section p,
  .about-section li,
  .about-related li {
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .about-section p + ul,
  .about-section p + ol,
  .about-section ol + p {
    margin-top: 12px;
  }

  .about-section ul,
  .about-section ol,
  .about-related ul {
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .about-contact {
    list-style: none;
    padding-left: 0;
  }
</style>
