---
import { useTranslations } from '../i18n/utils';
import { privacyPath } from '../i18n/paths';

export interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);
---

<div
  id="measurement-banner"
  class="measure"
  role="dialog"
  aria-labelledby="measure-title"
  aria-describedby="measure-text"
  hidden
>
  <p class="measure__label" id="measure-label">{t('measure.label')}</p>
  <p class="measure__title" id="measure-title">{t('measure.title')}</p>
  <p class="measure__text" id="measure-text">{t('measure.body')}</p>
  <a class="measure__policy" href={privacyPath(lang)}>{t('measure.privacy')}</a>
  <div class="measure__actions">
    <button type="button" class="measure__choice measure__choice--reject" data-measurement="reject">
      {t('measure.reject')}
    </button>
    <button type="button" class="measure__choice measure__choice--accept" data-measurement="accept">
      {t('measure.accept')}
    </button>
  </div>
</div>

<script is:inline>
  (function () {
    var banner = document.getElementById('measurement-banner');
    if (!banner) return;
    var choice = null;
    try {
      var saved = JSON.parse(localStorage.getItem('sacartx-measurement') || 'null');
      if (saved && saved.version === '2026-11-13' && (saved.choice === 'granted' || saved.choice === 'denied')) {
        choice = saved.choice;
      }
    } catch (error) {
      choice = null;
    }
    if (choice) banner.hidden = true;
    else {
      banner.hidden = false;
      document.documentElement.style.setProperty('--measure-raise', banner.offsetHeight + 24 + 'px');
    }
  })();
</script>

<script>
  import Clarity from '@microsoft/clarity';

  const STORAGE_KEY = 'sacartx-measurement';
  const NOTICE_VERSION = '2026-11-13';
  const GA_ID = 'GT-T94TPG7N';
  const CLARITY_ID = 'zd9zexpe6f';

  type Choice = 'granted' | 'denied';
  type MeasurementWindow = Window & {
    dataLayer?: IArguments[];
    gtag?: (...args: unknown[]) => void;
    __sacMeasurementLoaded?: boolean;
    __sacMeasurementBound?: boolean;
  };

  function measurementWindow() {
    return window as MeasurementWindow;
  }

  function readChoice(): Choice | null {
    try {
      const saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || 'null') as {
        choice?: string;
        version?: string;
      } | null;
      if (!saved || saved.version !== NOTICE_VERSION) return null;
      if (saved.choice === 'granted' || saved.choice === 'denied') return saved.choice;
    } catch {
      return null;
    }
    return null;
  }

  function writeChoice(choice: Choice) {
    localStorage.setItem(
      STORAGE_KEY,
      JSON.stringify({
        choice,
        at: new Date().toISOString(),
        version: NOTICE_VERSION,
      }),
    );
  }

  function loadMeasurement() {
    const win = measurementWindow();
    if (win.__sacMeasurementLoaded) return;
    win.__sacMeasurementLoaded = true;

    const script = document.createElement('script');
    script.async = true;
    script.src = `https://www.googletagmanager.com/gtag/js?id=${GA_ID}`;
    document.head.appendChild(script);

    win.dataLayer = win.dataLayer || [];
    win.gtag = function gtag() {
      win.dataLayer?.push(arguments);
    };
    win.gtag('js', new Date());
    win.gtag('config', GA_ID);
    Clarity.init(CLARITY_ID);
  }

  function placeBanner() {
    const banner = document.getElementById('measurement-banner');
    if (!banner || banner.hidden) {
      document.documentElement.style.removeProperty('--measure-raise');
      return;
    }
    document.documentElement.style.setProperty('--measure-raise', `${banner.offsetHeight + 24}px`);
  }

  function hideBanner() {
    const banner = document.getElementById('measurement-banner');
    if (!banner) return;
    banner.hidden = true;
    placeBanner();
  }

  function showBanner() {
    const banner = document.getElementById('measurement-banner');
    if (!banner) return;
    banner.hidden = false;
    placeBanner();
  }

  function applyChoice() {
    const choice = readChoice();
    if (choice === 'granted') {
      hideBanner();
      loadMeasurement();
      return;
    }
    if (choice === 'denied') {
      hideBanner();
      return;
    }
    showBanner();
  }

  function choose(choice: Choice) {
    const previous = readChoice();
    writeChoice(choice);
    if (previous === 'granted' && choice === 'denied') {
      location.reload();
      return;
    }
    applyChoice();
  }

  const win = measurementWindow();
  if (!win.__sacMeasurementBound) {
    win.__sacMeasurementBound = true;
    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const button = target.closest<HTMLElement>('[data-measurement]');
      if (!button) return;
      const action = button.dataset.measurement;
      if (action === 'accept') choose('granted');
      if (action === 'reject') choose('denied');
    });
    document.addEventListener('astro:page-load', applyChoice);
    window.addEventListener('resize', placeBanner);
  }

  applyChoice();
</script>

<style>
  .measure {
    position: fixed;
    z-index: 45;
    left: 20px;
    bottom: 20px;
    width: min(400px, calc(100vw - 112px));
    padding: 18px 18px 16px;
    background: var(--color-bg);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    border-top: 2px solid var(--color-gold);
    box-shadow: 0 16px 40px rgba(42, 31, 38, 0.12);
  }

  .measure[hidden] {
    display: none;
  }

  .measure__label {
    margin: 0 0 4px;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-gold-text);
  }

  .measure__title {
    margin: 0 0 8px;
    font-family: var(--font-heading);
    font-size: 26px;
    font-weight: 500;
    line-height: 1.1;
  }

  .measure__text {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .measure__policy {
    display: inline-block;
    margin: 8px 0 14px;
    color: var(--color-accent-text);
    font-size: 14px;
    text-underline-offset: 0.16em;
  }

  .measure__actions {
    display: flex;
    gap: 8px;
  }

  .measure__choice {
    flex: 1;
    min-height: 44px;
    padding: 10px 12px;
    border-radius: 4px;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 500;
    cursor: pointer;
  }

  .measure__choice--reject {
    background: var(--color-bg);
    color: var(--color-btn);
    border: 1.5px solid var(--color-btn);
  }

  .measure__choice--reject:hover {
    background: var(--color-bg-alt);
  }

  .measure__choice--accept {
    background: var(--color-btn);
    color: #fff;
    border: 1.5px solid var(--color-btn);
  }

  .measure__choice--accept:hover {
    background: var(--color-btn-hover);
  }

  .measure__choice:focus-visible,
  .measure__policy:focus-visible {
    outline: 2px solid var(--color-accent-text);
    outline-offset: 2px;
  }

  @media (max-width: 540px) {
    .measure {
      left: 12px;
      right: 12px;
      bottom: 12px;
      width: auto;
      padding: 16px 14px 14px;
    }

    .measure__title {
      font-size: 22px;
    }

    .measure__actions {
      flex-direction: column;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .measure__choice {
      transition: none;
    }
  }
</style>

<style is:global>
  @media (max-width: 540px) {
    html:has(#measurement-banner:not([hidden])) .wa-fab-wrap {
      bottom: var(--measure-raise, 360px);
    }

    html:has(#measurement-banner:not([hidden])) .back-top {
      bottom: calc(var(--measure-raise, 360px) + 64px);
    }
  }
</style>
