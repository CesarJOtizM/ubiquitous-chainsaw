---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from './Navbar.astro';
import Footer from './Footer.astro';
import WhatsAppFAB from './WhatsAppFAB.astro';
import { business, founderId } from '../data/business';
import { aboutPath, blogPath, blogPostPath, homePath, type Lang } from '../i18n/paths';

export interface Props {
  /** The blog collection entry to render. */
  post: any;
  /** The counterpart entry in the other language (shared translationKey), or null. */
  translation?: any | null;
}

const { post, translation = null } = Astro.props;
const data = post.data;
const lang: Lang = data.lang;
const otherLang: Lang = lang === 'en' ? 'es' : 'en';
const SITE = business.site;

const { Content } = await render(post);

const canonicalUrl = `${SITE}${blogPostPath(data.slug, lang)}`;
const homeUrl = `${SITE}${homePath(lang)}`;
const blogUrl = `${SITE}${blogPath(lang)}`;

// Reciprocal hreflang only when a real translation exists; otherwise self/x-default.
const selfEs = lang === 'es' ? canonicalUrl : null;
const selfEn = lang === 'en' ? canonicalUrl : null;
const translationUrl = translation ? `${SITE}${blogPostPath(translation.data.slug, otherLang)}` : null;
const alternateEs = lang === 'es' ? canonicalUrl : translationUrl ?? canonicalUrl;
const alternateEn = lang === 'en' ? canonicalUrl : translationUrl ?? canonicalUrl;

// Language switch target for the navbar: the translated post when it exists,
// otherwise the blog index in the other language.
const langSwitchHref = translationUrl
  ? blogPostPath(translation.data.slug, otherLang)
  : blogPath(otherLang);

const locale = lang === 'en' ? 'en-US' : 'es-CO';
const dateFmt = new Intl.DateTimeFormat(locale, { day: 'numeric', month: 'long', year: 'numeric' });
const pubLabel = dateFmt.format(data.pubDate);
const updatedLabel = data.updatedDate ? dateFmt.format(data.updatedDate) : null;

const labels =
  lang === 'en'
    ? {
        home: 'Home',
        blog: 'Blog',
        crumb: 'Breadcrumb',
        by: 'By',
        published: 'Published',
        updated: 'Updated',
        back: '← All posts',
        close: 'Close',
        prev: 'Previous photo',
        next: 'Next photo',
        viewer: 'Enlarged photo',
        enlarge: 'Enlarge photo',
      }
    : {
        home: 'Inicio',
        blog: 'Blog',
        crumb: 'Miga de pan',
        by: 'Por',
        published: 'Publicado',
        updated: 'Actualizado',
        back: '← Todas las entradas',
        close: 'Cerrar',
        prev: 'Foto anterior',
        next: 'Foto siguiente',
        viewer: 'Foto ampliada',
        enlarge: 'Ampliar foto',
      };

const authorUrl = `${SITE}${aboutPath(lang)}`;
const coverUrl = data.cover
  ? (/^https?:\/\//.test(data.cover) ? data.cover : `${SITE}${data.cover.startsWith('/') ? data.cover : `/${data.cover}`}`)
  : undefined;

const blogPosting: Record<string, any> = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${canonicalUrl}#blogposting`,
  headline: data.title,
  description: data.description,
  datePublished: data.pubDate.toISOString(),
  dateModified: (data.updatedDate ?? data.pubDate).toISOString(),
  inLanguage: lang === 'en' ? 'en' : 'es-CO',
  author: {
    '@type': 'Person',
    '@id': founderId,
    name: business.founder,
    url: authorUrl,
  },
  publisher: { '@id': `${SITE}/#business` },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
  url: canonicalUrl,
  ...(data.tags && data.tags.length ? { keywords: data.tags.join(', ') } : {}),
  ...(coverUrl ? { image: coverUrl } : {}),
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: labels.home, item: homeUrl },
    { '@type': 'ListItem', position: 2, name: labels.blog, item: blogUrl },
    { '@type': 'ListItem', position: 3, name: data.title, item: canonicalUrl },
  ],
};

const extraJsonLd = [blogPosting, breadcrumb];
---

<BaseLayout
  lang={lang}
  title={`${data.title} · Sac_Artx`}
  description={data.description}
  ogUrl={canonicalUrl}
  ogImage={coverUrl ?? undefined}
  canonicalUrl={canonicalUrl}
  alternateEs={alternateEs}
  alternateEn={alternateEn}
  markdownAlt={false}
  extraJsonLd={extraJsonLd}
>
  <Navbar lang={lang} langSwitchHref={langSwitchHref} />
  <main>
    <article class="post-page">
      <header class="post-hero">
        <div class="container">
          <nav class="post-crumb" aria-label={labels.crumb}>
            <a href={homePath(lang)}>{labels.home}</a>
            <span aria-hidden="true">/</span>
            <a href={blogPath(lang)}>{labels.blog}</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">{data.title}</span>
          </nav>
          <h1 class="post-hero__title">{data.title}</h1>
          <p class="post-hero__meta">
            <span class="post-hero__author">{labels.by} {business.founder}</span>
            <span aria-hidden="true">·</span>
            <time datetime={data.pubDate.toISOString()}>{labels.published} {pubLabel}</time>
            {updatedLabel && (
              <>
                <span aria-hidden="true">·</span>
                <time datetime={data.updatedDate.toISOString()}>{labels.updated} {updatedLabel}</time>
              </>
            )}
          </p>
        </div>
      </header>

      <div class="container post-body">
        <div class="post-prose">
          <Content />
        </div>
        <p class="post-back">
          <a href={blogPath(lang)}>{labels.back}</a>
        </p>
      </div>
    </article>
  </main>
  <Footer lang={lang} />
  <WhatsAppFAB lang={lang} />

  <div class="post-viewer" role="dialog" aria-modal="true" aria-label={labels.viewer} hidden>
    <div class="post-viewer__backdrop"></div>
    <button class="post-viewer__close" type="button" aria-label={labels.close}>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
    <div class="post-viewer__shell">
      <button class="post-viewer__nav post-viewer__prev" type="button" aria-label={labels.prev}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
      <div class="post-viewer__content">
        <div class="post-viewer__media"></div>
        <div class="post-viewer__meta">
          <p class="post-viewer__caption"></p>
          <p class="post-viewer__counter"></p>
        </div>
      </div>
      <button class="post-viewer__nav post-viewer__next" type="button" aria-label={labels.next}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
  </div>
</BaseLayout>

<style>
  .post-page {
    padding-bottom: clamp(64px, 8vw, 120px);
  }

  .post-hero {
    padding: clamp(100px, 14vw, 140px) 0 clamp(24px, 4vw, 40px);
  }

  .post-crumb {
    display: flex;
    gap: 8px;
    align-items: center;
    flex-wrap: wrap;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-bottom: 20px;
  }

  .post-crumb a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .post-crumb a:hover {
    text-decoration: underline;
  }

  .post-hero__title {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 400;
    margin: 8px 0 16px;
    max-width: 820px;
  }

  .post-hero__meta {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    align-items: center;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }

  .post-hero__author {
    font-weight: 500;
    color: var(--color-text);
  }

  .post-body,
  .post-prose {
    max-width: 720px;
  }

  .post-prose :global(h2) {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 500;
    margin: clamp(32px, 4vw, 48px) 0 12px;
  }

  .post-prose :global(h3) {
    font-size: clamp(1.25rem, 2.5vw, 1.5rem);
    font-weight: 500;
    margin: clamp(24px, 3vw, 32px) 0 10px;
  }

  .post-prose :global(p),
  .post-prose :global(li) {
    font-size: 1.0625rem;
    line-height: 1.75;
  }

  .post-prose :global(p) {
    margin-bottom: 16px;
  }

  .post-prose :global(ul),
  .post-prose :global(ol) {
    padding-left: 1.25rem;
    margin-bottom: 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .post-prose :global(strong) {
    font-weight: 600;
  }

  .post-prose :global(a) {
    color: var(--color-accent);
    text-underline-offset: 3px;
  }

  .post-prose :global(a:hover) {
    color: var(--color-accent-hover);
  }

  .post-prose :global(.photo-pair) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px 16px;
    margin: 8px 0 28px;
  }

  .post-prose :global(.photo-card) {
    margin: 0;
    min-width: 0;
  }

  .post-prose :global(.photo-open) {
    display: block;
    width: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    border-radius: 16px;
    cursor: zoom-in;
    color: inherit;
  }

  .post-prose :global(.photo-open:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .post-prose :global(.photo-open:hover img) {
    box-shadow: 0 12px 28px rgba(137, 70, 166, 0.16);
  }

  .post-prose :global(.photo-card img) {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 16px;
    background: var(--color-bg-alt);
  }

  .post-prose :global(.photo-card figcaption) {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin-top: 10px;
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--color-text-muted);
  }

  .post-prose :global(.photo-tag) {
    flex: none;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 3px 7px;
    border-radius: 999px;
    line-height: 1.3;
  }

  .post-prose :global(.photo-tag--no) {
    color: #8A4A3A;
    background: #F8E4DC;
  }

  .post-prose :global(.photo-tag--yes) {
    color: var(--color-accent-hover);
    background: var(--color-bg-alt);
  }

  @media (max-width: 520px) {
    .post-prose :global(.photo-pair) {
      gap: 16px 10px;
    }

    .post-prose :global(.photo-card figcaption) {
      flex-direction: column;
      gap: 4px;
    }
  }

  .post-back {
    margin-top: clamp(32px, 4vw, 48px);
  }

  .post-back a {
    color: var(--color-accent);
    text-decoration: none;
    font-size: 0.9375rem;
  }

  .post-back a:hover {
    text-decoration: underline;
  }

  .post-viewer {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: stretch;
    justify-content: center;
    overflow: hidden;
  }

  .post-viewer[hidden] {
    display: none;
  }

  .post-viewer__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(20, 16, 14, 0.92);
    backdrop-filter: blur(6px);
  }

  .post-viewer__shell {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 16px;
    width: 100%;
    max-width: 1100px;
    height: 100%;
    padding: 72px 24px 28px;
    box-sizing: border-box;
  }

  .post-viewer__content {
    flex: 1;
    min-width: 0;
    min-height: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .post-viewer__media {
    flex: 1;
    min-height: 0;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .post-viewer__media :global(img) {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 8px;
    background: #fff;
  }

  .post-viewer__meta {
    flex: none;
    text-align: center;
    max-width: 640px;
  }

  .post-viewer__caption,
  .post-viewer__counter {
    font-size: 0.9375rem;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.78);
  }

  .post-viewer__counter {
    margin-top: 4px;
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.55);
  }

  .post-viewer__close,
  .post-viewer__nav {
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .post-viewer__close {
    position: absolute;
    top: 20px;
    right: 24px;
    z-index: 2;
    width: 40px;
    height: 40px;
  }

  .post-viewer__nav {
    position: absolute;
    top: 50%;
    z-index: 2;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    transform: translateY(-50%);
  }

  .post-viewer__prev {
    left: 16px;
  }

  .post-viewer__next {
    right: 16px;
  }

  .post-viewer__nav:disabled {
    opacity: 0.25;
    cursor: default;
  }

  @media (max-width: 640px) {
    .post-viewer__shell {
      padding: 68px 12px 20px;
      gap: 8px;
    }

    .post-viewer__nav {
      width: 36px;
      height: 36px;
    }
  }
</style>

<script define:vars={{ enlargeLabel: labels.enlarge }}>
  const cards = Array.from(document.querySelectorAll('.photo-card'));
  const viewer = document.querySelector('.post-viewer');
  if (cards.length && viewer instanceof HTMLElement) {
    const media = viewer.querySelector('.post-viewer__media');
    const captionEl = viewer.querySelector('.post-viewer__caption');
    const counterEl = viewer.querySelector('.post-viewer__counter');
    const btnClose = viewer.querySelector('.post-viewer__close');
    const btnPrev = viewer.querySelector('.post-viewer__prev');
    const btnNext = viewer.querySelector('.post-viewer__next');
    const backdrop = viewer.querySelector('.post-viewer__backdrop');

    const buttons = cards.flatMap((card) => {
      const img = card.querySelector('img');
      if (!(img instanceof HTMLImageElement)) return [];
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'photo-open';
      const alt = img.alt.trim();
      button.setAttribute('aria-label', alt ? `${enlargeLabel}: ${alt}` : enlargeLabel);
      img.replaceWith(button);
      button.append(img);
      return [button];
    });

    let activeIndex = 0;
    let prevFocus = null;

    function largerSrc(src) {
      const url = new URL(src, location.origin);
      const tr = url.searchParams.get('tr');
      if (tr) url.searchParams.set('tr', tr.replace(/w-\d+/, 'w-1600'));
      return `${url.pathname}${url.search}`;
    }

    function captionFor(button) {
      const caption = button.closest('.photo-card')?.querySelector('figcaption');
      return (caption?.textContent || '').replace(/\s+/g, ' ').trim();
    }

    function render(index) {
      const button = buttons[index];
      const img = button?.querySelector('img');
      if (!(img instanceof HTMLImageElement) || !(media instanceof HTMLElement)) return;
      if (captionEl) captionEl.textContent = captionFor(button);
      if (counterEl) counterEl.textContent = `${index + 1} / ${buttons.length}`;
      media.replaceChildren();
      const full = new Image();
      full.alt = img.alt;
      full.src = largerSrc(img.currentSrc || img.src);
      media.append(full);
      if (btnPrev instanceof HTMLButtonElement) btnPrev.disabled = index === 0;
      if (btnNext instanceof HTMLButtonElement) btnNext.disabled = index === buttons.length - 1;
    }

    function openViewer(button) {
      activeIndex = Math.max(0, buttons.indexOf(button));
      prevFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      viewer.hidden = false;
      document.documentElement.style.overflow = 'hidden';
      document.body.style.overflow = 'hidden';
      render(activeIndex);
      if (btnClose instanceof HTMLButtonElement) btnClose.focus();
    }

    function closeViewer() {
      viewer.hidden = true;
      document.documentElement.style.overflow = '';
      document.body.style.overflow = '';
      if (media instanceof HTMLElement) media.replaceChildren();
      prevFocus?.focus();
    }

    buttons.forEach((button) => {
      button.addEventListener('click', () => openViewer(button));
    });

    btnClose?.addEventListener('click', closeViewer);
    backdrop?.addEventListener('click', closeViewer);
    btnPrev?.addEventListener('click', () => {
      if (activeIndex > 0) render(--activeIndex);
    });
    btnNext?.addEventListener('click', () => {
      if (activeIndex < buttons.length - 1) render(++activeIndex);
    });

    document.addEventListener('keydown', (event) => {
      if (viewer.hidden) return;
      if (event.key === 'Escape') closeViewer();
      if (event.key === 'ArrowLeft' && activeIndex > 0) render(--activeIndex);
      if (event.key === 'ArrowRight' && activeIndex < buttons.length - 1) render(++activeIndex);
    });

    let touchStartX = 0;
    viewer.addEventListener('touchstart', (event) => {
      touchStartX = event.changedTouches[0]?.clientX ?? event.touches[0].clientX;
    }, { passive: true });
    viewer.addEventListener('touchend', (event) => {
      const endX = event.changedTouches[0]?.clientX ?? 0;
      const delta = touchStartX - endX;
      if (Math.abs(delta) < 50 || viewer.hidden) return;
      if (delta > 0 && activeIndex < buttons.length - 1) render(++activeIndex);
      if (delta < 0 && activeIndex > 0) render(--activeIndex);
    });
  }
</script>
