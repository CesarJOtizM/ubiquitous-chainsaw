---
import { useTranslations } from '../i18n/utils';
import { alternatePath, catalogPath, homePath, isCatalogPath, isPricesPath, pricesPath } from '../i18n/paths';

export interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);

const WA_BASE = 'https://wa.me/573016584401?text=';
const WA_URL = `${WA_BASE}${t('nav.cta') === 'Order via WhatsApp' ? 'Hello!%20I\'d%20like%20to%20commission%20a%20portrait' : '%C2%A1Hola!%20Me%20gustar%C3%ADa%20encargar%20un%20retrato'}`;

const otherLang = lang === 'es' ? 'en' : 'es';
const home = homePath(lang);
const catalogHref = catalogPath(lang);
const pricesHref = pricesPath(lang);
const onCatalog = isCatalogPath(Astro.url.pathname);
const onPrices = isPricesPath(Astro.url.pathname);
const langSwitchHref = alternatePath(Astro.url.pathname, otherLang);

const links = [
  { href: `${home}#servicios`, label: t('nav.services'), current: false },
  { href: catalogHref, label: t('nav.gallery'), current: onCatalog },
  { href: pricesHref, label: t('prices.navLabel'), current: onPrices },
  { href: `${home}#proceso`, label: t('nav.process'), current: false },
  { href: `${home}#contacto`, label: t('nav.contact'), current: false },
];
---

<!-- Persist header + mobile menu together so chrome never remounts between routes -->
<div id="site-nav-root" transition:persist="site-nav">
  <header id="navbar" class="navbar">
    <div class="navbar__inner container">
      <a
        href={lang === 'en' ? '/en/' : '/'}
        class="navbar__logo"
        aria-label={lang === 'en' ? 'Sac_Artx — home' : 'Sac_Artx — inicio'}
      >
        Sac_Artx
      </a>

      <nav class="navbar__desktop" aria-label={t('nav.desktopLabel')}>
        {links.map((link) => (
          <a
            href={link.href}
            class:list={['navbar__link', { 'navbar__link--current': link.current }]}
            aria-current={link.current ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))}
        <a
          href={langSwitchHref}
          class="navbar__lang-switch"
          aria-label={t('nav.langSwitchLabel')}
          hreflang={otherLang}
        >
          {t('nav.langSwitch')}
        </a>
        <a href={WA_URL} class="btn btn-whatsapp navbar__cta" target="_blank" rel="noopener noreferrer">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
          {t('nav.whatsapp')}
        </a>
      </nav>

      <button
        id="menu-toggle"
        class="navbar__hamburger"
        aria-label={t('nav.menuOpen')}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </header>

  <div id="mobile-menu" class="mobile-menu" aria-hidden="true" role="dialog" aria-label={t('nav.mobileLabel')}>
    <button id="menu-close" class="mobile-menu__close" aria-label={t('nav.menuClose')}>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M18 6L6 18M6 6l12 12"/>
      </svg>
    </button>
    <nav class="mobile-menu__nav" aria-label={t('nav.mobileLabel')}>
      {links.map((link) => (
        <a
          href={link.href}
          class:list={['mobile-menu__link', { 'mobile-menu__link--current': link.current }]}
          aria-current={link.current ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
      <a
        href={langSwitchHref}
        class="mobile-menu__lang-switch"
        aria-label={t('nav.langSwitchLabel')}
        hreflang={otherLang}
      >
        {t('nav.langSwitch')}
      </a>
      <a href={WA_URL} class="mobile-menu__wa" target="_blank" rel="noopener noreferrer">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
        </svg>
        {t('nav.waOrder')}
      </a>
    </nav>
  </div>
</div>

<style>
  /*
    Full-viewport layer so View Transitions capture the fixed header
    (a 0-height wrapper would leave the bar in the root snapshot → flicker).
  */
  #site-nav-root {
    position: fixed;
    inset: 0;
    z-index: 100;
    pointer-events: none;
  }

  #site-nav-root .navbar {
    pointer-events: auto;
  }

  /* Closed menu must not steal clicks over the page */
  #site-nav-root .mobile-menu {
    pointer-events: none;
  }
  #site-nav-root .mobile-menu.open {
    pointer-events: auto;
  }

  .navbar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    /* Solid bg — translucent nav shows page swaps underneath (looks like flicker) */
    background: var(--color-bg);
    box-shadow: 0 1px 0 transparent;
  }

  .navbar.scrolled {
    box-shadow: 0 1px 0 var(--color-border);
  }

  .navbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }

  .navbar__logo {
    font-family: var(--font-logo);
    font-size: 28px;
    font-weight: 500;
    letter-spacing: 0.05em;
    color: var(--color-text);
    text-decoration: none;
    transition: color 0.2s;
  }

  .navbar__logo:hover {
    color: var(--color-accent);
  }

  .navbar__desktop {
    display: flex;
    align-items: center;
    gap: 36px;
  }

  .navbar__link {
    font-size: 15px;
    font-weight: 400;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s;
    position: relative;
  }

  .navbar__link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--color-accent);
    transform: scaleX(0);
    transition: transform 0.25s ease;
  }

  .navbar__link:hover {
    color: var(--color-text);
  }

  .navbar__link:hover::after,
  .navbar__link--current::after {
    transform: scaleX(1);
  }

  .navbar__link--current {
    color: var(--color-text);
  }

  /* Language switcher pill */
  .navbar__lang-switch {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    text-decoration: none;
    border: 1.5px solid var(--color-border);
    border-radius: 20px;
    padding: 4px 12px;
    transition: border-color 0.2s, color 0.2s;
  }

  .navbar__lang-switch:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .navbar__cta {
    padding: 10px 20px;
    font-size: 14px;
    border-radius: 4px;
  }

  /* Hamburger */
  .navbar__hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    cursor: pointer;
    background: none;
    border: none;
    padding: 8px;
  }

  .navbar__hamburger span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--color-text);
    border-radius: 2px;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .navbar__hamburger.active span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .navbar__hamburger.active span:nth-child(2) {
    opacity: 0;
  }

  .navbar__hamburger.active span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mobile menu */
  .mobile-menu {
    position: fixed;
    inset: 0;
    background: var(--color-bg);
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    transform: translateX(100%);
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .mobile-menu.open {
    transform: translateX(0);
  }

  .mobile-menu__close {
    position: absolute;
    top: 24px;
    right: 24px;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-text);
    padding: 8px;
  }

  .mobile-menu__nav {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    text-align: center;
  }

  .mobile-menu__link {
    font-family: var(--font-heading);
    font-size: 42px;
    font-weight: 300;
    color: var(--color-text);
    text-decoration: none;
    transition: color 0.2s;
    padding: 8px 24px;
  }

  .mobile-menu__link:hover,
  .mobile-menu__link--current {
    color: var(--color-accent);
  }

  /* Mobile language switcher */
  .mobile-menu__lang-switch {
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--color-text);
    text-decoration: none;
    border: 1.5px solid var(--color-border);
    border-radius: 20px;
    padding: 6px 20px;
    margin-top: 8px;
    transition: border-color 0.2s, color 0.2s;
  }

  .mobile-menu__lang-switch:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .mobile-menu__wa {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 16px;
    background: #1a7a3c;
    color: #fff;
    padding: 14px 28px;
    border-radius: 4px;
    text-decoration: none;
    font-size: 16px;
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .navbar__desktop {
      display: none;
    }

    .navbar__hamburger {
      display: flex;
    }
  }
</style>

<script>
  function normalizePath(path: string) {
    const clean = path.replace(/#.*$/, '').replace(/\/+$/, '');
    return clean === '' ? '/' : clean;
  }

  function isHomePath(path: string) {
    return path === '/' || path === '/en';
  }

  function syncNavbarScroll() {
    const navbar = document.getElementById('navbar');
    if (!navbar) return;
    const path = normalizePath(window.location.pathname);
    // Solid bar on inner pages so scroll-reset on navigate doesn't flash transparent
    const solid = !isHomePath(path) || window.scrollY > 60;
    navbar.classList.toggle('scrolled', solid);
  }

  function closeMobileMenu() {
    const toggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    mobileMenu?.classList.remove('open');
    mobileMenu?.setAttribute('aria-hidden', 'true');
    toggle?.classList.remove('active');
    toggle?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  function syncLangSwitch(path: string) {
    const isCatalog = path.endsWith('/catalog') || path.endsWith('/catalogo');
    const isPrices = path.endsWith('/prices') || path.endsWith('/precios');
    const isPrivacy = path.endsWith('/privacy') || path.endsWith('/privacidad');
    const isEn = path === '/en' || path.startsWith('/en/');
    let href: string;
    if (isCatalog) href = isEn ? '/catalogo/' : '/en/catalog/';
    else if (isPrices) href = isEn ? '/precios/' : '/en/prices/';
    else if (isPrivacy) href = isEn ? '/privacidad/' : '/en/privacy/';
    else href = isEn ? '/' : '/en/';
    document.querySelectorAll<HTMLAnchorElement>('.navbar__lang-switch, .mobile-menu__lang-switch').forEach((a) => {
      a.setAttribute('href', href);
    });
  }

  function linkIsCurrent(href: string, path: string, hash: string) {
    const hashIdx = href.indexOf('#');
    if (hashIdx !== -1) {
      if (!isHomePath(path)) return false;
      const section = href.slice(hashIdx + 1);
      return section !== '' && section === hash;
    }
    return normalizePath(href) === path;
  }

  /** Keep current link highlight in sync when the navbar is persisted across routes. */
  function syncActiveLinks() {
    const path = normalizePath(window.location.pathname);
    const hash = window.location.hash.replace(/^#/, '');
    syncLangSwitch(path);
    document.querySelectorAll<HTMLAnchorElement>('.navbar__link, .mobile-menu__link').forEach((link) => {
      const href = link.getAttribute('href') || '';
      const isCurrent = linkIsCurrent(href, path, hash);
      const isDesktop = link.classList.contains('navbar__link');
      link.classList.toggle('navbar__link--current', isCurrent && isDesktop);
      link.classList.toggle('mobile-menu__link--current', isCurrent && !isDesktop);
      if (isCurrent) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    });
  }

  function bindNavbar() {
    const root = document.getElementById('site-nav-root');
    const toggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const closeBtn = document.getElementById('menu-close');

    syncNavbarScroll();
    syncActiveLinks();
    closeMobileMenu();

    if (!root || root.dataset.navBound === 'true') return;
    root.dataset.navBound = 'true';

    window.addEventListener('scroll', syncNavbarScroll, { passive: true });
    window.addEventListener('hashchange', syncActiveLinks);

    function openMenu() {
      mobileMenu?.classList.add('open');
      mobileMenu?.setAttribute('aria-hidden', 'false');
      toggle?.classList.add('active');
      toggle?.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }

    toggle?.addEventListener('click', () => {
      const isOpen = mobileMenu?.classList.contains('open');
      isOpen ? closeMobileMenu() : openMenu();
    });

    closeBtn?.addEventListener('click', closeMobileMenu);

    mobileMenu?.querySelectorAll('.mobile-menu__link, .mobile-menu__wa, .mobile-menu__lang-switch').forEach((link) => {
      link.addEventListener('click', closeMobileMenu);
    });

    // Same-page hash clicks (Servicios → Proceso) update highlight immediately
    document.querySelectorAll<HTMLAnchorElement>('.navbar__link, .mobile-menu__link').forEach((link) => {
      link.addEventListener('click', () => {
        const href = link.getAttribute('href') || '';
        if (!href.includes('#')) return;
        // Defer so location.hash is updated after the click
        requestAnimationFrame(() => syncActiveLinks());
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeMobileMenu();
    });
  }

  document.addEventListener('astro:page-load', bindNavbar);
</script>
