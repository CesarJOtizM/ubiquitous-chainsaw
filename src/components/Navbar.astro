---
import { useTranslations } from '../i18n/utils';
import {
  aboutPath,
  alternatePath,
  blogPath,
  catalogPath,
  intentPath,
  isAboutPath,
  isBlogIndexPath,
  isBlogPostPath,
  isCatalogPath,
  isPricesPath,
  matchIntentTopic,
  matchProduct,
  pricesPath,
  productPath,
} from '../i18n/paths';

export interface Props {
  lang?: 'es' | 'en';
  /** Overrides the computed language-switch target (used by blog posts for post-to-post hreflang). */
  langSwitchHref?: string;
}

type NavLink = {
  href: string;
  label: string;
  hint?: string;
  key: string;
  external?: boolean;
};

const { lang = 'es', langSwitchHref: langSwitchOverride } = Astro.props;
const t = useTranslations(lang);

const WA_BASE = 'https://wa.me/573016584401?text=';
const WA_URL = `${WA_BASE}${t('nav.cta') === 'Order via WhatsApp' ? 'Hello!%20I\'d%20like%20to%20commission%20a%20portrait' : '%C2%A1Hola!%20Me%20gustar%C3%ADa%20encargar%20un%20retrato'}`;

const otherLang = lang === 'es' ? 'en' : 'es';
const catalogHref = catalogPath(lang);
const pricesHref = pricesPath(lang);
const path = Astro.url.pathname;
const product = matchProduct(path);
const topic = matchIntentTopic(path);
const langSwitchHref = langSwitchOverride ?? alternatePath(path, otherLang);
const retratosCurrent = Boolean(product) || (topic !== null && topic !== 'how');

function isCurrent(key: string) {
  if (key === 'catalog') return isCatalogPath(path);
  if (key === 'prices') return isPricesPath(path);
  if (key === 'how') return topic === 'how';
  if (key === 'about') return isAboutPath(path);
  if (key === 'blog') return isBlogIndexPath(path) || isBlogPostPath(path);
  if (product && key === product) return true;
  if (key === 'pets' || key === 'memorial' || key === 'colombia') return topic === key;
  return false;
}

const groups: { title: string; links: NavLink[] }[] = [
  {
    title: t('nav.paintTitle'),
    links: [
      { href: productPath('paintings', lang), label: t('nav.paintings'), key: 'paintings' },
      { href: productPath('bases', lang), label: t('nav.bases'), key: 'bases' },
      { href: productPath('cases', lang), label: t('nav.cases'), key: 'cases' },
      { href: productPath('sizes', lang), label: t('nav.sizes'), hint: t('nav.sizesHint'), key: 'sizes' },
      {
        href: productPath('magnets', lang),
        label: t('nav.magnets'),
        hint: t('nav.magnetsHint'),
        key: 'magnets',
      },
    ],
  },
  {
    title: t('nav.petTitle'),
    links: [
      { href: intentPath('pets', lang), label: t('nav.pets'), hint: t('nav.petsHint'), key: 'pets' },
      { href: intentPath('memorial', lang), label: t('nav.memorial'), hint: t('nav.memorialHint'), key: 'memorial' },
      { href: intentPath('colombia', lang), label: t('nav.colombia'), hint: t('nav.colombiaHint'), key: 'colombia' },
    ],
  },
];

const primary: NavLink[] = [
  { href: catalogHref, label: t('nav.gallery'), key: 'catalog' },
  { href: pricesHref, label: t('prices.navLabel'), key: 'prices' },
  { href: intentPath('how', lang), label: t('nav.how'), key: 'how' },
  { href: aboutPath(lang), label: t('nav.about'), key: 'about' },
  { href: blogPath(lang), label: t('nav.blog'), key: 'blog' },
];
---

<!-- Persist header + mobile menu together so chrome never remounts between routes -->
<div id="site-nav-root" transition:persist="site-nav">
  <header id="navbar" class="navbar">
    <div class="navbar__inner container">
      <a
        href={lang === 'en' ? '/en/' : '/'}
        class="navbar__logo"
        aria-label={lang === 'en' ? 'Sac_Artx — home' : 'Sac_Artx — inicio'}
      >
        Sac_Artx
      </a>

      <nav class="navbar__desktop" aria-label={t('nav.desktopLabel')}>
        <details class="nav-details">
          <summary
            class:list={['navbar__link', 'navbar__summary', { 'is-current': retratosCurrent }]}
            data-nav-key="retratos"
          >
            {t('nav.retratos')}
            <svg class="navbar__chevron" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
              <path d="M2.2 4.2 6 8l3.8-3.8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </summary>
          <div class="nav-panel" id="nav-retratos" aria-label={t('nav.retratosLabel')}>
            <div class="nav-panel__grid">
              {groups.map((group) => (
                <div class="nav-panel__col">
                  <p class="nav-panel__title">{group.title}</p>
                  {group.links.map((link) => (
                    <a
                      href={link.href}
                      class:list={['nav-panel__link', { 'is-current': isCurrent(link.key) }]}
                      data-nav-key={link.key}
                      aria-current={isCurrent(link.key) ? 'page' : undefined}
                      data-astro-prefetch={link.external ? undefined : 'viewport'}
                      target={link.external ? '_blank' : undefined}
                      rel={link.external ? 'noopener noreferrer' : undefined}
                    >
                      <span class="nav-panel__label">
                        {link.label}
                        {link.external && (
                          <svg class="nav-panel__external" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
                            <path d="M4 2.5H2.5V9.5H9.5V8M6.5 2.5H9.5V5.5M9.2 2.8 5 7" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        )}
                      </span>
                      {link.hint && <span class="nav-panel__hint">{link.hint}</span>}
                      {link.external && <span class="sr-only">. {t('nav.externalLabel')}</span>}
                    </a>
                  ))}
                </div>
              ))}
            </div>
          </div>
        </details>

        {primary.map((link) => (
          <a
            href={link.href}
            class:list={['navbar__link', { 'is-current': isCurrent(link.key) }]}
            data-nav-key={link.key}
            aria-current={isCurrent(link.key) ? 'page' : undefined}
            data-astro-prefetch="viewport"
          >
            {link.label}
          </a>
        ))}
        <a
          href={langSwitchHref}
          class="navbar__lang-switch"
          aria-label={t('nav.langSwitchLabel')}
          hreflang={otherLang}
        >
          {t('nav.langSwitch')}
        </a>
        <a href={WA_URL} class="btn btn-whatsapp navbar__cta" target="_blank" rel="noopener noreferrer">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
          {t('nav.whatsapp')}
        </a>
      </nav>

      <button
        type="button"
        id="menu-toggle"
        class="navbar__hamburger"
        aria-label={t('nav.menuOpen')}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </header>

  <div id="mobile-menu" class="mobile-menu" aria-hidden="true" inert role="dialog" aria-label={t('nav.mobileLabel')}>
    <button type="button" id="menu-close" class="mobile-menu__close" aria-label={t('nav.menuClose')}>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M18 6L6 18M6 6l12 12"/>
      </svg>
    </button>
    <nav class="mobile-menu__nav" aria-label={t('nav.mobileLabel')}>
      {groups.map((group) => (
        <div class="mobile-menu__group">
          <p class="mobile-menu__title">{group.title}</p>
          {group.links.map((link) => (
            <a
              href={link.href}
              class:list={['mobile-menu__link', 'mobile-menu__sublink', { 'is-current': isCurrent(link.key) }]}
              data-nav-key={link.key}
              aria-current={isCurrent(link.key) ? 'page' : undefined}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener noreferrer' : undefined}
            >
              {link.label}
            </a>
          ))}
        </div>
      ))}
      <div class="mobile-menu__group">
        {primary.map((link) => (
          <a
            href={link.href}
            class:list={['mobile-menu__link', { 'is-current': isCurrent(link.key) }]}
            data-nav-key={link.key}
            aria-current={isCurrent(link.key) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))}
      </div>
      <a
        href={langSwitchHref}
        class="mobile-menu__lang-switch"
        aria-label={t('nav.langSwitchLabel')}
        hreflang={otherLang}
      >
        {t('nav.langSwitch')}
      </a>
      <a href={WA_URL} class="mobile-menu__wa" target="_blank" rel="noopener noreferrer">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
        </svg>
        {t('nav.waOrder')}
      </a>
    </nav>
  </div>
</div>

<style>
  /*
    Full-viewport layer so View Transitions capture the fixed header
    (a 0-height wrapper would leave the bar in the root snapshot → flicker).
  */
  #site-nav-root {
    position: fixed;
    inset: 0;
    z-index: 100;
    pointer-events: none;
  }

  #site-nav-root .navbar {
    pointer-events: auto;
  }

  #site-nav-root .mobile-menu {
    pointer-events: none;
  }
  #site-nav-root .mobile-menu.open {
    pointer-events: auto;
  }

  .navbar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: var(--color-bg);
    box-shadow: 0 1px 0 transparent;
  }

  .navbar.scrolled {
    box-shadow: 0 1px 0 var(--color-border);
  }

  .navbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }

  .navbar__logo {
    font-family: var(--font-logo);
    font-size: 28px;
    font-weight: 500;
    letter-spacing: 0.05em;
    color: var(--color-text);
    text-decoration: none;
    transition: color 0.2s;
  }

  .navbar__logo:hover {
    color: var(--color-accent);
  }

  .navbar__desktop {
    position: relative;
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .navbar__link {
    font-size: 15px;
    font-weight: 400;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s;
    position: relative;
  }

  .navbar__link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--color-accent);
    transform: scaleX(0);
    transition: transform 0.25s ease;
  }

  .navbar__link:hover {
    color: var(--color-text);
  }

  .navbar__link:hover::after,
  .navbar__link.is-current::after,
  .nav-details[open] > .navbar__summary::after {
    transform: scaleX(1);
  }

  .navbar__link.is-current {
    color: var(--color-text);
  }

  .nav-details > .navbar__summary {
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    padding: 10px 0;
  }

  .nav-details > .navbar__summary::-webkit-details-marker {
    display: none;
  }

  .navbar__summary:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  .navbar__chevron {
    transition: transform 0.2s ease;
  }

  .nav-details[open] .navbar__chevron {
    transform: rotate(180deg);
  }

  .nav-panel {
    position: absolute;
    top: calc(100% + 18px);
    right: 0;
    width: min(640px, calc(100vw - 32px));
    padding: 18px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    box-shadow: 0 16px 40px rgb(0 0 0 / 0.08);
  }

  .nav-panel__grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 8px 28px;
  }

  .nav-panel__title {
    margin: 0 0 6px;
    padding: 0 10px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .nav-panel__link {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-height: 44px;
    justify-content: center;
    padding: 8px 10px;
    border-radius: 6px;
    text-decoration: none;
    color: var(--color-text);
  }

  .nav-panel__link:hover,
  .nav-panel__link.is-current {
    background: var(--color-bg-alt, rgb(0 0 0 / 0.04));
  }

  .nav-panel__link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .nav-panel__label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 15px;
  }

  .nav-panel__link.is-current .nav-panel__label {
    color: var(--color-accent);
  }

  .nav-panel__hint {
    font-size: 13px;
    line-height: 1.4;
    color: var(--color-text-muted);
  }

  .nav-panel__external {
    flex: none;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .navbar__lang-switch {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    text-decoration: none;
    border: 1.5px solid var(--color-border);
    border-radius: 20px;
    padding: 4px 12px;
    transition: border-color 0.2s, color 0.2s;
  }

  .navbar__lang-switch:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .navbar__cta {
    padding: 10px 20px;
    font-size: 14px;
    border-radius: 4px;
  }

  .navbar__hamburger {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    min-width: 44px;
    min-height: 44px;
    cursor: pointer;
    background: none;
    border: none;
    padding: 8px;
  }

  .navbar__hamburger span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--color-text);
    border-radius: 2px;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .navbar__hamburger.active span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .navbar__hamburger.active span:nth-child(2) {
    opacity: 0;
  }

  .navbar__hamburger.active span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    background: var(--color-bg);
    z-index: 200;
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
    overflow: auto;
    transform: translateX(100%);
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .mobile-menu.open {
    transform: translateX(0);
  }

  .mobile-menu__close {
    position: absolute;
    top: 24px;
    right: 24px;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-text);
    padding: 8px;
  }

  .mobile-menu__nav {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    width: min(100%, 520px);
    padding: 88px 28px 40px;
  }

  .mobile-menu__group {
    display: flex;
    flex-direction: column;
    width: 100%;
    margin-bottom: 12px;
  }

  .mobile-menu__title {
    margin: 16px 0 4px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .mobile-menu__link {
    font-size: 22px;
    font-weight: 400;
    color: var(--color-text);
    text-decoration: none;
    padding: 10px 0;
    min-height: 44px;
  }

  .mobile-menu__sublink {
    font-size: 18px;
  }

  .mobile-menu__link:hover,
  .mobile-menu__link.is-current {
    color: var(--color-accent);
  }

  .mobile-menu__lang-switch {
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--color-text);
    text-decoration: none;
    border: 1.5px solid var(--color-border);
    border-radius: 20px;
    padding: 6px 20px;
    margin-top: 8px;
    transition: border-color 0.2s, color 0.2s;
  }

  .mobile-menu__lang-switch:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .mobile-menu__wa {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 16px;
    background: #1a7a3c;
    color: #fff;
    padding: 14px 28px;
    border-radius: 4px;
    text-decoration: none;
    font-size: 16px;
    font-weight: 500;
  }

  @media (max-width: 1040px) {
    .navbar__desktop {
      display: none;
    }

    .navbar__hamburger {
      display: flex;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .navbar__chevron,
    .mobile-menu,
    .navbar__hamburger span {
      transition: none;
    }
  }
</style>

<script>
  import {
    alternatePath,
    isAboutPath,
    isBlogIndexPath,
    isBlogPostPath,
    isCatalogPath,
    isPricesPath,
    matchIntentTopic,
    matchProduct,
    type Lang,
  } from '../i18n/paths';

  function normalizePath(path: string) {
    const clean = path.replace(/#.*$/, '').replace(/\/+$/, '');
    return clean === '' ? '/' : clean;
  }

  function isHomePath(path: string) {
    return path === '/' || path === '/en';
  }

  function syncNavbarScroll() {
    const navbar = document.getElementById('navbar');
    if (!navbar) return;
    const path = normalizePath(window.location.pathname);
    const solid = !isHomePath(path) || window.scrollY > 60;
    navbar.classList.toggle('scrolled', solid);
  }

  function closeMobileMenu(restoreFocus = false) {
    const toggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const wasOpen = mobileMenu?.classList.contains('open');
    mobileMenu?.classList.remove('open');
    mobileMenu?.setAttribute('aria-hidden', 'true');
    mobileMenu?.setAttribute('inert', '');
    toggle?.classList.remove('active');
    toggle?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    if (restoreFocus && wasOpen) toggle?.focus();
  }

  function closeRetratos() {
    document.querySelectorAll('details.nav-details').forEach((details) => {
      details.open = false;
    });
  }

  function syncLangSwitch(path: string) {
    const isEn = path === '/en' || path.startsWith('/en/');
    const other: Lang = isEn ? 'es' : 'en';
    const isBlogPost = /^\/(en\/)?blog\/.+/.test(path);
    document.querySelectorAll<HTMLAnchorElement>('.navbar__lang-switch, .mobile-menu__lang-switch').forEach((a) => {
      if (isBlogPost) {
        const current = (a.getAttribute('href') || '').replace(/\/+$/, '');
        if (/^\/(en\/)?blog\/.+/.test(current)) return;
      }
      a.setAttribute('href', alternatePath(window.location.pathname, other));
    });
  }

  function activeKeys(path: string) {
    const keys = new Set<string>();
    if (isCatalogPath(path)) keys.add('catalog');
    if (isPricesPath(path)) keys.add('prices');
    if (isAboutPath(path)) keys.add('about');
    if (isBlogIndexPath(path) || isBlogPostPath(path)) keys.add('blog');
    const product = matchProduct(path);
    if (product) {
      keys.add('retratos');
      keys.add(product);
    }
    const topic = matchIntentTopic(path);
    if (topic === 'how') keys.add('how');
    else if (topic) {
      keys.add('retratos');
      if (topic === 'pets' || topic === 'memorial' || topic === 'colombia') keys.add(topic);
    }
    return keys;
  }

  /** Keep current link highlight in sync when the navbar is persisted across routes. */
  function syncActiveLinks() {
    const path = window.location.pathname;
    syncLangSwitch(normalizePath(path));
    const keys = activeKeys(path);
    document.querySelectorAll<HTMLElement>('[data-nav-key]').forEach((el) => {
      const key = el.getAttribute('data-nav-key') || '';
      const isCurrent = keys.has(key);
      el.classList.toggle('is-current', isCurrent);
      if (el instanceof HTMLAnchorElement) {
        if (isCurrent) el.setAttribute('aria-current', 'page');
        else el.removeAttribute('aria-current');
      }
    });
  }

  function bindNavbar() {
    const root = document.getElementById('site-nav-root');
    const toggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const closeBtn = document.getElementById('menu-close');

    syncNavbarScroll();
    syncActiveLinks();
    closeMobileMenu();
    closeRetratos();

    if (!root || root.dataset.navBound === 'true') return;
    root.dataset.navBound = 'true';

    window.addEventListener('scroll', syncNavbarScroll, { passive: true });
    window.addEventListener('hashchange', syncActiveLinks);

    function openMenu() {
      closeRetratos();
      mobileMenu?.classList.add('open');
      mobileMenu?.setAttribute('aria-hidden', 'false');
      mobileMenu?.removeAttribute('inert');
      toggle?.classList.add('active');
      toggle?.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      closeBtn?.focus();
    }

    toggle?.addEventListener('click', () => {
      const isOpen = mobileMenu?.classList.contains('open');
      isOpen ? closeMobileMenu(true) : openMenu();
    });

    closeBtn?.addEventListener('click', () => closeMobileMenu(true));

    mobileMenu?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => closeMobileMenu());
    });

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Node)) return;
      document.querySelectorAll('details.nav-details').forEach((details) => {
        if (details.open && !details.contains(target)) details.open = false;
      });
    });

    root.querySelectorAll('details.nav-details a').forEach((link) => {
      link.addEventListener('click', () => closeRetratos());
    });

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      const openDetails = document.querySelector('details.nav-details[open]');
      if (openDetails) {
        openDetails.open = false;
        openDetails.querySelector('summary')?.focus();
        return;
      }
      closeMobileMenu(true);
    });
  }

  document.addEventListener('astro:page-load', bindNavbar);
</script>
