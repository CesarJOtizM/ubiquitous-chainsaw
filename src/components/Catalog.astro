---
import { useTranslations } from '../i18n/utils';
import { catalogLines, itemsForLine } from '../data/catalog';
import { homePath } from '../i18n/paths';

export interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);
const home = homePath(lang);
const waBase = 'https://wa.me/573016584401?text=';

const lines = catalogLines.map((line) => {
  const items = itemsForLine(line.id);
  const name = t(line.name);
  return {
    id: line.id,
    name,
    desc: t(line.desc),
    price: t(line.price),
    medium: t(line.medium),
    orderHref: `${waBase}${encodeURIComponent(t(line.wa))}`,
    count: items.length,
    countLabel: items.length === 1 ? t('catalog.piece') : t('catalog.pieces'),
    items: items.map((item, index) => ({
      src: item.src,
      alt: `${name} ${String(index + 1).padStart(2, '0')} — Sac_Artx`,
      indexLabel: String(index + 1).padStart(2, '0'),
    })),
  };
});
---

<div class="catalog-page" data-catalog-page>
  <header class="catalog-hero">
    <div class="container">
      <nav class="catalog-crumb" aria-label={lang === 'en' ? 'Breadcrumb' : 'Miga de pan'}>
        <a href={home}>{t('catalog.crumbHome')}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{t('catalog.title')}</span>
      </nav>
      <p class="section-label">{t('catalog.label')}</p>
      <h1 class="catalog-hero__title">{t('catalog.title')}</h1>
      <p class="catalog-hero__subtitle">{t('catalog.subtitle')}</p>
    </div>
  </header>

  <nav class="catalog-jump" aria-label={t('catalog.navLabel')}>
    <div class="container catalog-jump__scroller">
      {lines.map((line, index) => (
        <a
          href={`#${line.id}`}
          class:list={['catalog-jump__link', { 'is-active': index === 0 }]}
          aria-current={index === 0 ? 'true' : undefined}
        >
          {line.name}
        </a>
      ))}
    </div>
  </nav>

  <div class="catalog-lines">
    {lines.map((line) => (
      <section class="catalog-line" id={line.id} aria-labelledby={`${line.id}-title`}>
        <div class="container">
          <div class="catalog-line__head">
            <div>
              <p class="catalog-line__medium">{line.medium}</p>
              <h2 class="catalog-line__title" id={`${line.id}-title`}>{line.name}</h2>
              <p class="catalog-line__desc">{line.desc}</p>
            </div>
            <div class="catalog-line__buy">
              <p class="catalog-line__price">{line.price}</p>
              <p class="catalog-line__count">{line.count} {line.countLabel}</p>
              <a
                class="btn btn-whatsapp catalog-line__order"
                href={line.orderHref}
                target="_blank"
                rel="noopener noreferrer"
              >
                {t('catalog.order')}
              </a>
            </div>
          </div>

          <ul class="catalog-grid">
            {line.items.map((item) => (
              <li>
                <button
                  type="button"
                  class="catalog-card"
                  data-line={line.id}
                  data-src={item.src}
                  data-name={line.name}
                  data-medium={line.medium}
                >
                  <span class="catalog-card__frame">
                    <img
                      src={item.src}
                      alt={item.alt}
                      width="800"
                      height="800"
                      loading="lazy"
                      decoding="async"
                    />
                  </span>
                  <span class="catalog-card__caption">
                    <span class="catalog-card__index">{item.indexLabel}</span>
                    <span class="catalog-card__name">{line.name}</span>
                    <span class="catalog-card__action">{t('catalog.viewPiece')}</span>
                  </span>
                </button>
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))}
  </div>

  <button type="button" class="catalog-top" hidden>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="18 15 12 9 6 15"></polyline>
    </svg>
    {t('catalog.backToTop')}
  </button>

  <div
    class="catalog-viewer"
    role="dialog"
    aria-modal="true"
    aria-label={t('catalog.viewer')}
    hidden
  >
    <div class="catalog-viewer__backdrop"></div>
    <button class="catalog-viewer__close" type="button" aria-label={t('catalog.close')}>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
    <div class="catalog-viewer__shell">
      <button class="catalog-viewer__nav catalog-viewer__prev" type="button" aria-label={t('catalog.prev')}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
      <div class="catalog-viewer__content">
        <div class="catalog-viewer__media"></div>
        <div class="catalog-viewer__meta">
          <p class="catalog-viewer__name"></p>
          <p class="catalog-viewer__medium"></p>
          <p class="catalog-viewer__counter"></p>
        </div>
      </div>
      <button class="catalog-viewer__nav catalog-viewer__next" type="button" aria-label={t('catalog.next')}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
  </div>
</div>

<style is:global>
  html:has(.catalog-page) {
    scroll-behavior: auto;
  }
</style>

<style>
  .catalog-page {
    padding-top: 88px;
    background:
      radial-gradient(ellipse 50% 30% at 100% 0%, rgba(234, 153, 213, 0.35), transparent 70%),
      radial-gradient(ellipse 40% 28% at 0% 18%, rgba(183, 98, 193, 0.16), transparent 70%),
      var(--color-bg);
  }

  .catalog-hero {
    padding: 28px 0 20px;
  }

  .catalog-crumb {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 28px;
    font-size: 13px;
    color: var(--color-text-muted);
  }

  .catalog-crumb a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .catalog-crumb a:hover {
    color: var(--color-accent);
  }

  .catalog-hero__title {
    font-family: var(--font-heading);
    font-size: clamp(52px, 8vw, 88px);
    font-weight: 400;
    line-height: 0.95;
    color: var(--color-text);
    margin-bottom: 16px;
  }

  .catalog-hero__subtitle {
    max-width: 38rem;
    font-size: 17px;
    color: var(--color-text-muted);
  }

  .catalog-jump {
    position: sticky;
    top: 72px;
    z-index: 40;
    background: rgba(255, 245, 249, 0.94);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
  }

  .catalog-jump__scroller {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-top: 12px;
    padding-bottom: 12px;
    scrollbar-width: none;
  }

  .catalog-jump__scroller::-webkit-scrollbar {
    display: none;
  }

  .catalog-jump__link {
    flex: 0 0 auto;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-text-muted);
    text-decoration: none;
    border: 1.5px solid var(--color-border);
    border-radius: 40px;
    padding: 8px 16px;
    background: transparent;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }

  .catalog-jump__link:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .catalog-jump__link.is-active {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #fff;
  }

  .catalog-line {
    scroll-margin-top: 148px;
    padding: clamp(40px, 6vw, 72px) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .catalog-line:last-child {
    border-bottom: 0;
  }

  .catalog-line__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 24px 48px;
    align-items: end;
    margin-bottom: 28px;
  }

  .catalog-line__medium {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: 8px;
  }

  .catalog-line__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 400;
    line-height: 1.05;
    margin-bottom: 10px;
  }

  .catalog-line__desc {
    max-width: 36rem;
    color: var(--color-text-muted);
  }

  .catalog-line__buy {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
    text-align: right;
  }

  .catalog-line__price {
    font-family: var(--font-heading);
    font-size: 32px;
    line-height: 1;
    color: var(--color-text);
  }

  .catalog-line__count {
    font-size: 13px;
    color: var(--color-text-muted);
    margin-bottom: 8px;
  }

  .catalog-line__order {
    padding: 12px 20px;
    font-size: 14px;
    border-radius: 4px;
  }

  .catalog-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }

  .catalog-card {
    width: 100%;
    display: flex;
    flex-direction: column;
    text-align: left;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    overflow: hidden;
    cursor: pointer;
    color: inherit;
    padding: 0;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .catalog-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 28px rgba(137, 70, 166, 0.12);
  }

  .catalog-card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .catalog-card__frame {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1;
    background: var(--color-bg-card);
  }

  .catalog-card__frame img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .catalog-card__caption {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 2px 10px;
    padding: 12px 14px 14px;
  }

  .catalog-card__index {
    grid-row: span 2;
    align-self: center;
    font-family: var(--font-heading);
    font-size: 22px;
    color: var(--color-gold);
  }

  .catalog-card__name {
    font-size: 14px;
    font-weight: 500;
    color: var(--color-text);
  }

  .catalog-card__action {
    font-size: 13px;
    color: var(--color-accent);
  }

  .catalog-viewer {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .catalog-viewer[hidden] {
    display: none;
  }

  .catalog-viewer__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(20, 16, 14, 0.92);
    backdrop-filter: blur(6px);
  }

  .catalog-viewer__shell {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 16px;
    width: 100%;
    max-width: 1100px;
    padding: 0 24px;
  }

  .catalog-viewer__content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .catalog-viewer__media {
    width: 100%;
    max-height: 72vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .catalog-viewer__media img {
    max-width: 100%;
    max-height: 72vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 8px;
    background: #fff;
  }

  .catalog-viewer__meta {
    text-align: center;
  }

  .catalog-viewer__name {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #e7b6ea;
  }

  .catalog-viewer__medium,
  .catalog-viewer__counter {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.62);
  }

  .catalog-viewer__close,
  .catalog-viewer__nav {
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .catalog-viewer__close {
    position: absolute;
    top: 20px;
    right: 24px;
    z-index: 2;
    width: 40px;
    height: 40px;
  }

  .catalog-viewer__nav {
    position: relative;
    z-index: 1;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
  }

  .catalog-viewer__nav:disabled {
    opacity: 0.25;
    cursor: default;
  }

  @media (max-width: 980px) {
    .catalog-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .catalog-line__head,
    .catalog-line__buy {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      text-align: left;
    }

    .catalog-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .catalog-viewer__shell {
      padding: 0 12px;
      gap: 8px;
    }

    .catalog-viewer__nav {
      width: 36px;
      height: 36px;
    }
  }

  .catalog-top {
    position: fixed;
    z-index: 45;
    left: 32px;
    bottom: 32px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 18px;
    border: 0;
    border-radius: 40px;
    background: var(--color-text);
    color: #fff;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    box-shadow: 0 8px 24px rgba(42, 31, 38, 0.22);
  }

  .catalog-top[hidden] {
    display: none;
  }

  .catalog-top:hover {
    background: var(--color-accent-hover);
  }

  .catalog-top:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  @media (max-width: 640px) {
    .catalog-top {
      left: 16px;
      bottom: 24px;
      padding: 12px 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .catalog-card {
      transition: none;
    }
  }
</style>

<script>
  const page = document.querySelector<HTMLElement>('[data-catalog-page]');
  if (page) {
    const cards = Array.from(page.querySelectorAll<HTMLButtonElement>('.catalog-card'));
    const jumpLinks = Array.from(page.querySelectorAll<HTMLAnchorElement>('.catalog-jump__link'));
    const sections = Array.from(page.querySelectorAll<HTMLElement>('.catalog-line'));
    const viewer = page.querySelector<HTMLElement>('.catalog-viewer')!;
    const media = page.querySelector<HTMLElement>('.catalog-viewer__media')!;
    const nameEl = page.querySelector<HTMLElement>('.catalog-viewer__name')!;
    const mediumEl = page.querySelector<HTMLElement>('.catalog-viewer__medium')!;
    const counterEl = page.querySelector<HTMLElement>('.catalog-viewer__counter')!;
    const btnClose = page.querySelector<HTMLButtonElement>('.catalog-viewer__close')!;
    const btnPrev = page.querySelector<HTMLButtonElement>('.catalog-viewer__prev')!;
    const btnNext = page.querySelector<HTMLButtonElement>('.catalog-viewer__next')!;
    const backdrop = page.querySelector<HTMLElement>('.catalog-viewer__backdrop')!;

    let deck: HTMLButtonElement[] = [];
    let activeIndex = 0;
    let prevFocus: HTMLElement | null = null;

    function setActiveLink(id: string) {
      jumpLinks.forEach((link) => {
        const on = link.getAttribute('href') === `#${id}`;
        link.classList.toggle('is-active', on);
        if (on) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      });
    }

    const spyOffset = 170;
    let settleHash = location.hash.replace('#', '');

    function updateActiveFromScroll() {
      if (settleHash) {
        const target = document.getElementById(settleHash);
        const top = target?.getBoundingClientRect().top ?? 9999;
        const landed = Boolean(target) && top <= spyOffset && top > -40;
        if (!landed) return;
        settleHash = '';
      }

      let current = sections[0]?.id;
      for (const section of sections) {
        if (section.getBoundingClientRect().top <= spyOffset) current = section.id;
      }
      if (current) setActiveLink(current);
    }

    if (settleHash && document.getElementById(settleHash)) setActiveLink(settleHash);

    jumpLinks.forEach((link) => {
      link.addEventListener('click', (event) => {
        const id = link.getAttribute('href')?.slice(1);
        const section = id ? document.getElementById(id) : null;
        if (!id || !section) return;
        event.preventDefault();
        settleHash = '';
        section.scrollIntoView({ behavior: 'instant', block: 'start' });
        history.pushState(null, '', `#${id}`);
        setActiveLink(id);
      });
    });

    const topBtn = page.querySelector<HTMLButtonElement>('.catalog-top')!;

    function syncTopButton() {
      topBtn.hidden = window.scrollY < 480;
    }

    topBtn.addEventListener('click', () => {
      settleHash = '';
      window.scrollTo({ top: 0, behavior: 'instant' });
      const cleanUrl = `${location.pathname}${location.search}`;
      history.replaceState(null, '', cleanUrl);
      if (sections[0]) setActiveLink(sections[0].id);
      syncTopButton();
    });

    window.addEventListener('scroll', syncTopButton, { passive: true });
    syncTopButton();

    window.addEventListener('scroll', updateActiveFromScroll, { passive: true });
    window.addEventListener('load', updateActiveFromScroll);
    new ResizeObserver(() => updateActiveFromScroll()).observe(page);
    updateActiveFromScroll();

    function render(index: number) {
      const card = deck[index];
      if (!card) return;
      const src = card.dataset.src ?? '';
      const name = card.dataset.name ?? '';
      nameEl.textContent = name;
      mediumEl.textContent = card.dataset.medium ?? '';
      counterEl.textContent = `${index + 1} / ${deck.length}`;
      media.replaceChildren();
      const img = new Image();
      img.alt = name;
      img.src = src;
      media.appendChild(img);
      btnPrev.disabled = index === 0;
      btnNext.disabled = index === deck.length - 1;
    }

    function openViewer(card: HTMLButtonElement) {
      const line = card.dataset.line;
      deck = cards.filter((item) => item.dataset.line === line);
      activeIndex = Math.max(0, deck.indexOf(card));
      prevFocus = document.activeElement as HTMLElement;
      viewer.hidden = false;
      document.body.style.overflow = 'hidden';
      render(activeIndex);
      btnClose.focus();
    }

    function closeViewer() {
      viewer.hidden = true;
      document.body.style.overflow = '';
      media.replaceChildren();
      prevFocus?.focus();
    }

    cards.forEach((card) => {
      card.addEventListener('click', () => openViewer(card));
    });

    btnClose.addEventListener('click', closeViewer);
    backdrop.addEventListener('click', closeViewer);
    btnPrev.addEventListener('click', () => {
      if (activeIndex > 0) render(--activeIndex);
    });
    btnNext.addEventListener('click', () => {
      if (activeIndex < deck.length - 1) render(++activeIndex);
    });

    document.addEventListener('keydown', (event) => {
      if (viewer.hidden) return;
      if (event.key === 'Escape') closeViewer();
      if (event.key === 'ArrowLeft' && activeIndex > 0) render(--activeIndex);
      if (event.key === 'ArrowRight' && activeIndex < deck.length - 1) render(++activeIndex);
    });

    let touchStartX = 0;
    viewer.addEventListener('touchstart', (event) => {
      touchStartX = event.touches[0].clientX;
    }, { passive: true });
    viewer.addEventListener('touchend', (event) => {
      const delta = touchStartX - event.changedTouches[0].clientX;
      if (Math.abs(delta) < 50 || viewer.hidden) return;
      if (delta > 0 && activeIndex < deck.length - 1) render(++activeIndex);
      if (delta < 0 && activeIndex > 0) render(--activeIndex);
    });
  }
</script>
