---
import { ClientRouter } from 'astro:transitions';
import { Font } from 'astro:assets';
import PageDecor from '../components/PageDecor.astro';
import BackToTop from '../components/BackToTop.astro';
import MeasureNotice from '../components/MeasureNotice.astro';
import '../styles/global.css';
import { useTranslations } from '../i18n/utils';
import { areaServed } from '../data/coverage';
import { business, founderId, paymentMethods } from '../data/business';
import { aboutPath } from '../i18n/paths';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogUrl?: string;
  lang?: 'es' | 'en';
  canonicalUrl?: string;
  alternateEs?: string;
  alternateEn?: string;
  markdownAlt?: string | false;
  /** Title for the markdown alternate. Only used when `markdownAlt` is set. */
  markdownAltTitle?: string;
  /** Open Graph type. Blog posts use `article`. */
  ogType?: 'website' | 'article';
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  robots?: string;
  extraJsonLd?: object | object[];
  /** Responsive hero image, preloaded from the document head. */
  preloadImage?: { src: string; srcset: string; sizes: string };
}

const SITE = 'https://sacartx.art';
const FB_URL = 'https://www.facebook.com/profile.php?id=61561180858722';

const {
  lang = 'es',
  ogImage: ogImageProp = '/brand/og-image.png',
  canonicalUrl: canonicalProp,
  alternateEs: alternateEsProp,
  alternateEn: alternateEnProp,
  markdownAlt = false,
  markdownAltTitle,
  ogType = 'website',
  articlePublishedTime,
  articleModifiedTime,
  robots = 'index, follow',
  extraJsonLd,
  preloadImage,
} = Astro.props;

const htmlLang = lang === 'en' ? 'en' : 'es-CO';
const hreflangEs = 'es-CO';
const hreflangEn = 'en';

const t = useTranslations(lang);

const title = Astro.props.title ?? t('meta.title');
const description = Astro.props.description ?? t('meta.description');

const canonicalUrl = canonicalProp ?? (lang === 'en' ? `${SITE}/en/` : `${SITE}/`);
const alternateEs = alternateEsProp ?? `${SITE}/`;
const alternateEn = alternateEnProp ?? `${SITE}/en/`;
const ogUrl = Astro.props.ogUrl ?? canonicalUrl;
const ogImage = /^https?:\/\//.test(ogImageProp)
  ? ogImageProp
  : `${SITE}${ogImageProp.startsWith('/') ? ogImageProp : `/${ogImageProp}`}`;

const schemaOrg = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${SITE}/#website`,
      "url": SITE,
      "name": "Sac_Artx",
      "description": t('schema.description'),
      "inLanguage": lang === 'en' ? 'en' : 'es-CO',
      "publisher": { "@id": `${SITE}/#business` },
    },
    {
      "@type": ["LocalBusiness", "ArtGallery"],
      "@id": `${SITE}/#business`,
      "name": "Sac_Artx",
      "description": t('schema.description'),
      "url": SITE,
      "telephone": "+573016584401",
      "image": `${SITE}/brand/og-image.png`,
      "logo": {
        "@type": "ImageObject",
        "url": `${SITE}/brand/logo-square.png`,
      },
      "founder": {
        "@type": "Person",
        "@id": founderId,
        "name": business.founder,
        "jobTitle": lang === 'en' ? 'Artist' : 'Artista',
        "url": `${SITE}${aboutPath(lang)}`,
        "sameAs": [business.instagram, business.tiktok, business.facebook, business.youtube],
      },
      "address": {
        "@type": "PostalAddress",
        "addressCountry": "CO",
      },
      "areaServed": areaServed,
      "sameAs": [
        "https://www.instagram.com/sac_artx",
        "https://www.tiktok.com/@sac_artx",
        FB_URL,
        business.youtube,
        business.google,
      ],
      "knowsAbout": [
        "Pet portraits",
        "Dog portraits",
        "Cat portraits",
        "Rabbit portraits",
        "Horse portraits",
        "Bird portraits",
        "Acrylic painting",
        "Custom phone cases",
        "Landscape painting",
        "Retratos de mascotas",
        "Retratos de perros",
        "Retratos de gatos",
        "Retratos de conejos",
        "Retratos de caballos",
        "Retratos de aves",
        "Pintura en acrílico",
      ],
      "priceRange": "$$",
      "currenciesAccepted": "COP",
      "paymentAccepted": paymentMethods[lang === 'en' ? 'en' : 'es'],
    },
  ],
};
---

<!doctype html>
<html lang={htmlLang} transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Tag Manager. The container fires Google tag GT-T94TPG7N. -->
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-KZK6S278');
    </script>

    <!-- Clarity stays off until the visitor accepts. Also stays off on localhost. -->
    <script is:inline>
      (function () {
        var host = location.hostname;
        var local = host === 'localhost' || host === '127.0.0.1' || host === '::1';
        try {
          var saved = localStorage.getItem('sacartx-measure');
          if (saved === 'on' || saved === 'off') {
            document.documentElement.dataset.measure = saved;
          }
        } catch (e) {}

        function clarityAllowed() {
          if (local) return false;
          return document.documentElement.dataset.measure === 'on';
        }

        var proto = HTMLScriptElement.prototype;
        var srcDesc = Object.getOwnPropertyDescriptor(proto, 'src');
        if (srcDesc && srcDesc.get && srcDesc.set) {
          Object.defineProperty(proto, 'src', {
            configurable: true,
            enumerable: srcDesc.enumerable,
            get: function () {
              return srcDesc.get.call(this);
            },
            set: function (value) {
              if (String(value).indexOf('clarity.ms') !== -1 && !clarityAllowed()) return;
              srcDesc.set.call(this, value);
            },
          });
        }

        var setAttribute = proto.setAttribute;
        proto.setAttribute = function (name, value) {
          if (
            String(name).toLowerCase() === 'src' &&
            String(value).indexOf('clarity.ms') !== -1 &&
            !clarityAllowed()
          ) {
            return;
          }
          return setAttribute.call(this, name, value);
        };
      })();
    </script>

    <!-- Microsoft Clarity, project zd9zexpe6f. Loads only after the visitor accepts. -->
    <script>
      const clarityHost = location.hostname;
      const clarityLocal =
        clarityHost === 'localhost' || clarityHost === '127.0.0.1' || clarityHost === '::1';

      function startClarity() {
        if (clarityLocal || document.documentElement.dataset.measure !== 'on') return;
        import('@microsoft/clarity').then((mod) => {
          mod.default.init('zd9zexpe6f');
        });
      }

      startClarity();
      document.addEventListener('sacartx:measure', startClarity);
    </script>

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon"      href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180"    href="/apple-touch-icon.png" />
    <link rel="manifest"                            href="/site.webmanifest" />

    <!-- Primary Meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#B762C1" />

    <!-- Canonical & Hreflang -->
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang={hreflangEs} href={alternateEs} />
    <link rel="alternate" hreflang={hreflangEn} href={alternateEn} />
    <link rel="alternate" hreflang="x-default" href={alternateEs} />
    {markdownAlt && (
      <link
        rel="alternate"
        type="text/markdown"
        href={markdownAlt}
        title={markdownAltTitle}
      />
    )}
    <link rel="alternate" type="text/plain" href={`${SITE}/llms.txt`} title="Sac_Artx — resumen para IAs" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    {ogType === 'article' && articlePublishedTime && (
      <meta property="article:published_time" content={articlePublishedTime} />
    )}
    {ogType === 'article' && articleModifiedTime && (
      <meta property="article:modified_time" content={articleModifiedTime} />
    )}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:locale" content={t('meta.ogLocale')} />
    <meta property="og:site_name" content="Sac_Artx" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {preloadImage && (
      <link
        rel="preload"
        as="image"
        href={preloadImage.src}
        imagesrcset={preloadImage.srcset || undefined}
        imagesizes={preloadImage.srcset ? preloadImage.sizes : undefined}
        fetchpriority="high"
      />
    )}

    <Font cssVariable="--font-cormorant" />
    <Font cssVariable="--font-dm-sans" />

    <ClientRouter />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />
    {extraJsonLd && (
      Array.isArray(extraJsonLd)
        ? extraJsonLd.map((block) => (
            <script type="application/ld+json" set:html={JSON.stringify(block)} />
          ))
        : <script type="application/ld+json" set:html={JSON.stringify(extraJsonLd)} />
    )}

    <style is:global>
      /*
        Fixed chrome must leave the root snapshot. Otherwise the browser sets
        visibility:hidden on the live navbar during the transition → flicker.
      */
      #site-nav-root {
        view-transition-name: site-nav;
      }
      footer.footer {
        view-transition-name: site-footer;
      }
      .wa-fab-wrap {
        view-transition-name: site-fab;
      }

      /* Zero motion on every VT layer — swap only, no fades */
      ::view-transition-group(*),
      ::view-transition-old(*),
      ::view-transition-new(*) {
        animation: none !important;
        mix-blend-mode: normal;
      }

      ::view-transition-group(site-nav) {
        z-index: 1000;
      }

      ::view-transition-group(page-decor) {
        z-index: 0;
      }

      .nav-progress {
        position: fixed;
        inset: 0 0 auto 0;
        height: 3px;
        z-index: 1100;
        overflow: hidden;
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.15s ease;
      }
      .nav-progress::before {
        content: '';
        position: absolute;
        inset: 0;
        width: 40%;
        background: var(--color-accent, #B762C1);
        animation: nav-progress 1s ease-in-out infinite;
      }
      html.is-navigating .nav-progress {
        opacity: 1;
      }
      @keyframes nav-progress {
        from { transform: translateX(-100%); }
        to { transform: translateX(250%); }
      }

      html[data-navigated] main {
        animation: page-enter 0.35s ease both;
      }
      @keyframes page-enter {
        from { opacity: 0; transform: translateY(12px); }
        to { opacity: 1; transform: none; }
      }

      @media (prefers-reduced-motion: reduce) {
        .nav-progress::before,
        html[data-navigated] main {
          animation: none;
        }
      }
      ::view-transition-group(site-fab) {
        z-index: 900;
      }
    </style>
  </head>

  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-KZK6S278"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
      ></iframe>
    </noscript>
    <div class="nav-progress" aria-hidden="true"></div>
    <MeasureNotice lang={lang} />
    <PageDecor />
    <div class="page-shell">
      <slot />
      <BackToTop lang={lang} />
    </div>

    <script>
      document.addEventListener('astro:before-preparation', (event) => {
        document.documentElement.classList.add('is-navigating');
        // Astro restores focus to elements inside transition:persist after the swap;
        // focusing a persisted footer link scrolls the new page back down to it.
        const active = document.activeElement;
        if (event.to.pathname !== event.from.pathname && active instanceof HTMLElement && active.closest('[data-astro-transition-persist]')) {
          active.blur();
        }
      });
      document.addEventListener('astro:before-swap', (event) => {
        const nextLang = event.newDocument.documentElement.lang;
        if (!nextLang || nextLang === document.documentElement.lang) return;
        // Persisted chrome keeps the previous language. Drop it so the
        // incoming navbar, footer and WhatsApp button render in the new one.
        document.querySelectorAll('[data-astro-transition-persist]').forEach((el) => {
          el.removeAttribute('data-astro-transition-persist');
        });
      });
      document.addEventListener('astro:after-swap', () => {
        document.documentElement.classList.remove('is-navigating');
        document.documentElement.dataset.navigated = '';
      });
    </script>

    <!-- Scroll Reveal — re-run after client navigations -->
    <script>
      function initReveal() {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.05, rootMargin: '0px 0px -20px 0px' }
        );

        document.querySelectorAll('.reveal:not(.visible)').forEach((el) => {
          observer.observe(el);
        });
      }

      document.addEventListener('astro:page-load', initReveal);
    </script>

    <!-- Speed Insights starts after the first paint, or on the first tap. -->
    <script>
      type InsightHandle = { setRoute: (route: string | null) => void } | null;
      let insights: InsightHandle = null;
      let insightsStarting = false;

      async function startSpeedInsights() {
        if (insights || insightsStarting) return;
        insightsStarting = true;
        const { injectSpeedInsights, computeRoute } = await import('@vercel/speed-insights');
        insights = injectSpeedInsights({
          framework: 'astro',
          route: computeRoute(location.pathname, {}),
        });
      }

      function whenIdle() {
        if ('requestIdleCallback' in window) {
          requestIdleCallback(() => void startSpeedInsights(), { timeout: 4000 });
        } else {
          setTimeout(() => void startSpeedInsights(), 4000);
        }
      }

      window.addEventListener('load', () => {
        setTimeout(whenIdle, 2000);
      });
      window.addEventListener('pointerdown', () => void startSpeedInsights(), {
        once: true,
        passive: true,
      });
      window.addEventListener('keydown', () => void startSpeedInsights(), { once: true });

      document.addEventListener('astro:page-load', () => {
        if (!insights) return;
        void import('@vercel/speed-insights').then(({ computeRoute }) => {
          insights?.setRoute(computeRoute(location.pathname, {}));
        });
      });
    </script>
  </body>
</html>
