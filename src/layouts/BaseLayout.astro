---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { useTranslations } from '../i18n/utils';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogUrl?: string;
  lang?: 'es' | 'en';
  canonicalUrl?: string;
  alternateEs?: string;
  alternateEn?: string;
  markdownAlt?: string;
  extraJsonLd?: object | object[];
}

const SITE = 'https://sacartx.art';
const FB_URL = 'https://www.facebook.com/profile.php?id=61561180858722';

const {
  lang = 'es',
  ogImage: ogImageProp = '/brand/og-image.png',
  canonicalUrl: canonicalProp,
  alternateEs: alternateEsProp,
  alternateEn: alternateEnProp,
  markdownAlt = `${SITE}/info/preguntas.md`,
  extraJsonLd,
} = Astro.props;

const htmlLang = lang === 'en' ? 'en' : 'es-CO';
const hreflangEs = 'es-CO';
const hreflangEn = 'en';

const t = useTranslations(lang);

const title = Astro.props.title ?? t('meta.title');
const description = Astro.props.description ?? t('meta.description');

const canonicalUrl = canonicalProp ?? (lang === 'en' ? `${SITE}/en/` : `${SITE}/`);
const alternateEs = alternateEsProp ?? `${SITE}/`;
const alternateEn = alternateEnProp ?? `${SITE}/en/`;
const ogUrl = Astro.props.ogUrl ?? canonicalUrl;
const ogImage = /^https?:\/\//.test(ogImageProp)
  ? ogImageProp
  : `${SITE}${ogImageProp.startsWith('/') ? ogImageProp : `/${ogImageProp}`}`;

const schemaOrg = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${SITE}/#website`,
      "url": SITE,
      "name": "Sac_Artx",
      "description": t('schema.description'),
      "inLanguage": lang === 'en' ? 'en' : 'es-CO',
      "publisher": { "@id": `${SITE}/#business` },
    },
    {
      "@type": ["LocalBusiness", "ArtGallery"],
      "@id": `${SITE}/#business`,
      "name": "Sac_Artx",
      "description": t('schema.description'),
      "url": SITE,
      "telephone": "+573016584401",
      "image": `${SITE}/brand/og-image.png`,
      "logo": `${SITE}/brand/logo-square.png`,
      "founder": {
        "@type": "Person",
        "name": "Sara Amaya Caldas",
        "jobTitle": "Artista",
      },
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Bogotá",
        "addressRegion": "Bogotá D.C.",
        "addressCountry": "CO",
      },
      "areaServed": {
        "@type": "Country",
        "name": "Colombia",
      },
      "sameAs": [
        "https://www.instagram.com/sac_artx",
        "https://www.tiktok.com/@sac_artx",
        FB_URL,
      ],
      "knowsAbout": [
        "Pet portraits",
        "Dog portraits",
        "Cat portraits",
        "Rabbit portraits",
        "Horse portraits",
        "Bird portraits",
        "Acrylic painting",
        "Custom phone cases",
        "Landscape painting",
        "Retratos de mascotas",
        "Retratos de perros",
        "Retratos de gatos",
        "Retratos de conejos",
        "Retratos de caballos",
        "Retratos de aves",
        "Pintura en acrílico",
      ],
      "priceRange": "$$",
      "currenciesAccepted": "COP",
      "paymentAccepted": "Nequi, Daviplata, Transferencia bancaria, Efectivo",
    },
  ],
};
---

<!doctype html>
<html lang={htmlLang} transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon"      href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180"    href="/apple-touch-icon.png" />
    <link rel="manifest"                            href="/site.webmanifest" />

    <!-- Primary Meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#B762C1" />

    <!-- Canonical & Hreflang -->
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang={hreflangEs} href={alternateEs} />
    <link rel="alternate" hreflang={hreflangEn} href={alternateEn} />
    <link rel="alternate" hreflang="x-default" href={alternateEs} />
    <link rel="alternate" type="text/markdown" href={markdownAlt} title="Sac_Artx FAQ, español e inglés" />
    <link rel="alternate" type="text/plain" href={`${SITE}/llms.txt`} title="Sac_Artx — resumen para IAs" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:locale" content={t('meta.ogLocale')} />
    <meta property="og:site_name" content="Sac_Artx" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Logo font — preload so Sac_Artx does not flash between routes -->
    <link rel="preload" href="/fonts/Brightwall.ttf" as="font" type="font/ttf" crossorigin />

    <!-- Google Fonts — non-blocking load -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400;1,600&family=DM+Sans:wght@300;400;500;700&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400;1,600&family=DM+Sans:wght@300;400;500;700&display=swap"
      />
    </noscript>

    <ClientRouter />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />
    {extraJsonLd && (
      Array.isArray(extraJsonLd)
        ? extraJsonLd.map((block) => (
            <script type="application/ld+json" set:html={JSON.stringify(block)} />
          ))
        : <script type="application/ld+json" set:html={JSON.stringify(extraJsonLd)} />
    )}

    <style is:global>
      /*
        Fixed chrome must leave the root snapshot. Otherwise the browser sets
        visibility:hidden on the live navbar during the transition → flicker.
      */
      #site-nav-root {
        view-transition-name: site-nav;
      }
      footer.footer {
        view-transition-name: site-footer;
      }
      .wa-fab-wrap {
        view-transition-name: site-fab;
      }

      /* Zero motion on every VT layer — swap only, no fades */
      ::view-transition-group(*),
      ::view-transition-old(*),
      ::view-transition-new(*) {
        animation: none !important;
        mix-blend-mode: normal;
      }

      ::view-transition-group(site-nav) {
        z-index: 1000;
      }
      ::view-transition-group(site-fab) {
        z-index: 900;
      }
    </style>
  </head>

  <body>
    <slot />

    <!-- Scroll Reveal — re-run after client navigations -->
    <script>
      function initReveal() {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.05, rootMargin: '0px 0px -20px 0px' }
        );

        document.querySelectorAll('.reveal:not(.visible)').forEach((el) => {
          observer.observe(el);
        });
      }

      document.addEventListener('astro:page-load', initReveal);
    </script>

    <!-- Google Analytics 4 — load only after window load so it does not compete with first paint -->
    <script is:inline>
      window.addEventListener('load', function () {
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', 'G-DGVQ013LLR');
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-DGVQ013LLR';
        document.head.appendChild(s);
      });
    </script>
  </body>
</html>
