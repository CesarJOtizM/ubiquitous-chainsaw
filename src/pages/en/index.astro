---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Hero from '../../components/Hero.astro';
import Services from '../../components/Services.astro';
import Process from '../../components/Process.astro';
import CatalogPreview from '../../components/CatalogPreview.astro';
import Testimonials from '../../components/Testimonials.astro';
import FAQ from '../../components/FAQ.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppFAB from '../../components/WhatsAppFAB.astro';
import { useTranslations } from '../../i18n/utils';
import { getImage } from 'astro:assets';
import heroImg from '../../assets/hero.jpeg';

const lang = 'en' as const;
const t = useTranslations(lang);
const heroSizes = '(max-width: 768px) 92vw, 540px';
const heroPreload = await getImage({
  src: heroImg,
  format: 'webp',
  widths: [480, 640, 768, 1280],
  quality: 70,
});
---

<BaseLayout
  lang={lang}
  ogUrl="https://sacartx.art/en/"
  title={t('home.metaTitle')}
  description={t('home.metaDescription')}
  markdownAlt="https://sacartx.art/info/home.md"
  markdownAltTitle="Sac_Artx in text"
  preloadImage={{
    src: heroPreload.src,
    srcset: heroPreload.srcSet.attribute,
    sizes: heroSizes,
  }}
>
  <Navbar lang={lang} />
  <main>
    <Hero lang={lang} />
    <Services lang={lang} />
    <Process lang={lang} />
    <CatalogPreview lang={lang} />
    <Testimonials lang={lang} />
    <FAQ lang={lang} />
    <Contact lang={lang} />
  </main>
  <Footer lang={lang} />
  <WhatsAppFAB lang={lang} />
</BaseLayout>
