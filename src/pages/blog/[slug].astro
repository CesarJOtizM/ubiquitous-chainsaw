---
export const prerender = true;

import { getCollection } from 'astro:content';
import BlogPost from '../../components/BlogPost.astro';

export async function getStaticPaths() {
  const all = await getCollection('blog');
  const esPosts = all.filter((post: any) => post.data.lang === 'es' && !post.data.draft);
  return esPosts.map((post: any) => {
    const translation =
      post.data.translationKey
        ? all.find(
            (other: any) =>
              other.data.lang === 'en' &&
              !other.data.draft &&
              other.data.translationKey === post.data.translationKey,
          ) ?? null
        : null;
    return { params: { slug: post.data.slug }, props: { post, translation } };
  });
}

const { post, translation } = Astro.props;
---

<BlogPost post={post} translation={translation} />
